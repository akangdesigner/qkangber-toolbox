# Google 服務帳號 JSON（單行字串，與官網/n8n 同一個）
GOOGLE_SERVICE_ACCOUNT_JSON=

# master 試算表 ID
GOOGLE_SHEET_ID=1VwGs_i7b-kk9HQtd0gBbkS8bFSO8cU7esKSGhEtJVzM

# 新聞候選分頁名稱（新聞轉發控制台）
NEWS_SHEET_NAME=新聞候選

# Threads 發文：填你 Q kangber 帳號的 access token（沒填會報錯不發文）
# userId 會自動用 /me 取得，THREADS_USER_ID 可不填
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# 社群貼文產生器用
GROQ_API_KEY=

# 需要 JSON 回應的功能（新聞轉發控制台等）走 lib/llm-json：
# 有填 OPENROUTER_API_KEY 就優先用 OpenRouter，沒填才退回 Groq。
# 新聞那條免費 Groq 額度會不夠（一輪要打 8 次打分＋8 次寫稿），建議填 OpenRouter。
OPENROUTER_API_KEY=
# 選填，預設 openai/gpt-4.1-mini
OPENROUTER_MODEL=

# 梗圖配文控制台（選填）：Groq 看圖模型，預設 meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=
# 官網文章分頁名稱，預設 posts
POSTS_SHEET_NAME=

# 熱門 AI 話題推到 LINE（scripts/news-push.ts）。LINE Notify 已停止服務，要用 Messaging API：
# LINE Developers 建一個 Messaging API channel，Channel access token (long-lived) 貼這裡
LINE_CHANNEL_ACCESS_TOKEN=
# 同一個 channel 的 Basic settings →「Your user ID」（U 開頭），並且要先加那個官方帳號好友
LINE_USER_ID=
# 選填，熱度幾分以上才推，預設 65
NEWS_PUSH_MIN_HEAT=
# 選填，政府公告幾分以上才推，預設 8（＝一人公司／中小企業申請得到的補助或徵件）
NEWS_PUSH_GOV_MIN_SCORE=
